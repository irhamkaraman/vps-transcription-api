# ============================================
# VPS TRANSCRIPTION API - Environment Config
# ============================================
# Cara pakai: copy file ini jadi .env, lalu isi nilainya

# Model Whisper yang akan digunakan
# Pilihan: tiny, base, small, medium, large, large-v2, large-v3
# Rekomendasi untuk CPU 4-core: base (cepat) atau medium (akurat tapi lambat)
WHISPER_MODEL=base

# Jumlah CPU threads yang digunakan
# Sesuaikan dengan jumlah core server (16GB RAM, 4 core)
CPU_THREADS=4

# Beam size untuk Whisper (1 = paling cepat, 5 = lebih akurat tapi lambat)
# Rekomendasi: 1 untuk kecepatan maksimal di CPU
BEAM_SIZE=1

# VAD Filter: True = skip bagian sunyi (lebih cepat)
# False = transkripsi seluruh audio (lebih akurat tapi lambat)
VAD_FILTER=True

# Chunk length dalam detik (responsif untuk audio panjang)
CHUNK_LENGTH=30
